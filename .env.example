# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/ciphercode_dev?schema=public"

# Next.js
NEXT_PUBLIC_SITE_URL=""

# Authentication
AUTH_SECRET=""
AUTH_TRUST_HOST="false"

# JWT Secret for API routes
JWT_SECRET=""

# Resend Email
RESEND_API_KEY=""
RESEND_FROM="CipherCode <noreply@ciphercode.app>"

# Nodemailer SMTP (alternative to Resend)
NODEMAILER_HOST=""
NODEMAILER_PORT=587
NODEMAILER_USER=""
NODEMAILER_PASSWORD=""

# Telegram Bot API
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_ENCRYPTED="true"

# S3 Object Storage (MinIO or compatible)
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME="ciphercode-assets"
S3_REGION="us-east-1"

# Rate limiting (short-lived storage)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10

# Quote settings
QUOTE_VALIDITY_MINUTES=30
UNDERPAYMENT_TOLERANCE_PERCENT=5
OVERPAYMENT_ALLOWED=true

# Wallet cooldown (seconds)
WALLET_COOLDOWN_SECONDS=300

# Cleanup settings
AUTO_DELETE_USER_DATA_DAYS=30

# Deployment settings
DEPLOYMENT_PROVIDER=""
DEPLOYMENT_API_KEY=""
